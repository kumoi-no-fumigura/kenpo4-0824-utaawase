  {
   "seq": "20",
   "text": "あきかけていはねに霜をしき島や山遠くすむ小泊瀨の月",
   "kana": "",
   "speaker": "",
   "page": 239,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "人すまぬ野寺の小さゝ世々ふりて尾上の松にくもる月影",
   "kana": "",
   "speaker": "",
   "page": 239,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "あれはつる野寺の鐘はをともなしすむよの月の影にまかせて",
   "kana": "",
   "speaker": "",
   "page": 239,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "雲の色は猶山ふかき小泊瀨に月ゆへしもの鐘ひゝくらむ",
   "kana": "",
   "speaker": "",
   "page": 239,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "はつせ山檜原のかせにきをひつゝもりくるかねも明方の月",
   "kana": "",
   "speaker": "",
   "page": 239,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "泊瀨山つきものとかにすむそらのあけまくつらき鐘のをと哉",
   "kana": "",
   "speaker": "",
   "page": 239,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "むかしおもふたかのゝ山の深きよに曉とをくすめる月かけ",
   "kana": "",
   "speaker": "",
   "page": 239,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "をはつせやひはらか月は晴にけり入あひのかねに秋風そふく",
   "kana": "",
   "speaker": "",
   "page": 239,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "はつせ山杉の庵のひまよりも月にはみゆる秋のいろかな",
   "kana": "",
   "speaker": "",
   "page": 239,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "山さとの峯の木葉やちりぬらむ枕にちかき秋のかりかね",
   "kana": "",
   "speaker": "",
   "page": 239,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "なくかりの涙かつちる山かせに衣手うすきみちの空哉",
   "kana": "",
   "speaker": "",
   "page": 239,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "あらし吹こゑはあらちの山のはにつはさもさむくかり渡る也",
   "kana": "",
   "speaker": "",
   "page": 239,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "かせさむみ雲もくらふの山のはに幾つらとたにわかぬ雁かね",
   "kana": "",
   "speaker": "",
   "page": 239,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "山たかみさこそあらしの名なりとも殘るこのはゝかりの一行",
   "kana": "",
   "speaker": "",
   "page": 239,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "富士の山みねとひこえてゆくかりの翅の霜を吹あらし哉",
   "kana": "",
   "speaker": "",
   "page": 239,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "雁のなく山の秋かせ夜やさむき翅の月を霜にまかせて",
   "kana": "",
   "speaker": "",
   "page": 239,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "むら時雨はれ行秋にとふかりのはかせもさむき山のはの月",
   "kana": "",
   "speaker": "",
   "page": 239,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "萩のうへも霜にさえ行山風になみたや氷る秋のかり金",
   "kana": "",
   "speaker": "",
   "page": 239,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "あき山にをく初霜の朝あらしに雁のなくねもくたけてそ行",
   "kana": "",
   "speaker": "",
   "page": 239,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "み山路やはれゆく月の影さえてかりのは風も夜さむ成らん",
   "kana": "",
   "speaker": "",
   "page": 239,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "山かせのさえゆく夜はやいかならむこほらて落るかりの泪も",
   "kana": "",
   "speaker": "",
   "page": 239,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "いこま山更ゆく月にとふ雁の翅にもろき秋のはつしも",
   "kana": "",
   "speaker": "",
   "page": 239,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "天とふやをのかはかひをもる霜の寒き山への衣かりかね",
   "kana": "",
   "speaker": "",
   "page": 239,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "たつぬへきそなたの空も雨雲のへたてゝ遠き戀の道哉",
   "kana": "",
   "speaker": "",
   "page": 239,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "大かたのよにふる雨をなかめても袖の雫を人のとへかし",
   "kana": "",
   "speaker": "",
   "page": 239,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "徒らに嶺のあま雲よそなから身をしる袖そぬれてかひなき",
   "kana": "",
   "speaker": "",
   "page": 239,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "思ひあまり世をふる雨の雫にもをとらすぬるゝ我袂哉",
   "kana": "",
   "speaker": "",
   "page": 239,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "せきあえぬ雫は袖のよそならすさすかにみゆる峯の雨雲",
   "kana": "",
   "speaker": "",
   "page": 239,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "つらさには厭はしなからいかにして我身世にふる袖のむら雨",
   "kana": "",
   "speaker": "",
   "page": 239,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "なかき夜のくらき窓うつ秋の雨に雫もかはる袖の色哉",
   "kana": "",
   "speaker": "",
   "page": 239,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "きのふみぬ軒のしのふも露ふかしみをしる雨やけふはそふ覽",
   "kana": "",
   "speaker": "",
   "page": 239,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "むら時雨たもとの露の數そへてしはし涙そ人めつゝまぬ",
   "kana": "",
   "speaker": "",
   "page": 239,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "かく計り思ひたえてはなからましふるとも雨にとたに賴ます",
   "kana": "",
   "speaker": "",
   "page": 239,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "おもひわひぬ身をしる雨とかこちても契らぬそらの秋の夕暮",
   "kana": "",
   "speaker": "",
   "page": 239,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "さても猶ねられぬ夜半の村雨にこぬ人まちし月そ戀しき",
   "kana": "",
   "speaker": "",
   "page": 240,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "大方のなかめにまさる袂かな軒の忍ふの秋のむらさめ",
   "kana": "",
   "speaker": "",
   "page": 240,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "ふれはけにわかみにさても久かたの雨の下にはしけき思ひを",
   "kana": "",
   "speaker": "",
   "page": 240,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "わたの原あらいそ浪の岩の上によせくる玉のくたけてそふる",
   "kana": "",
   "speaker": "",
   "page": 240,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "とことはに浪こす沖の離れ石にあはぬためしの名さへ恨めし",
   "kana": "",
   "speaker": "",
   "page": 240,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "あふ事はよゝにかたくとさゝれいしの苔むす迄に猶も待みむ",
   "kana": "",
   "speaker": "",
   "page": 240,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "心さしなからのはまのさゝれいしの數ゝにやは人をうらみん",
   "kana": "",
   "speaker": "",
   "page": 240,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "われのみや岩うつ浪のうらみかねくたけても猶立かへるらん",
   "kana": "",
   "speaker": "",
   "page": 240,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "我袖は浪にしたかふさゝれ石のひかたきのみやたくひ成らん",
   "kana": "",
   "speaker": "",
   "page": 240,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "名とり川おもひにしつむ淵の石のいつあらはれむ契ともなし",
   "kana": "",
   "speaker": "",
   "page": 240,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "あふ事の浪うつおきの岩の上によらぬ玉藻のみたれかねつゝ",
   "kana": "",
   "speaker": "",
   "page": 240,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "石はしる瀧つなみたの消かへりうきておもひの果そかなしき",
   "kana": "",
   "speaker": "",
   "page": 240,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "なみた河みなはに沈む玉かしはくちぬためしは己れのみかは",
   "kana": "",
   "speaker": "",
   "page": 240,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "逢事はまれにもかたきさゝれ石の巖とならん行ゑしらせよ",
   "kana": "",
   "speaker": "",
   "page": 240,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "まてとかやたのめしよるの契たにしらてやたえむ久米の岩橋",
   "kana": "",
   "speaker": "",
   "page": 240,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "もの思ふ色こそみえねいしま行水のこゝろはせくかたそなき",
   "kana": "",
   "speaker": "",
   "page": 240,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "あかしかた浦よりをちのはなれ石の獨りも浪に幾よぬれなむ",
   "kana": "",
   "speaker": "",
   "page": 240,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "我こひはあしもたゆますおもへとも人こそしらね夢の通路",
   "kana": "",
   "speaker": "",
   "page": 240,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "なけきわひれぬよの空に月日へて夢のかよひち跡やふりなん",
   "kana": "",
   "speaker": "",
   "page": 240,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "賴めつる夢もむなしくあけぬとやきゝおとろけと鳥も鳴らむ",
   "kana": "",
   "speaker": "",
   "page": 240,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "なみた河いくよ淵せとしつみきてわたる名もなき夢の浮はし",
   "kana": "",
   "speaker": "",
   "page": 240,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "あたし世のはかなき夢の契たにむすはぬ人を思ひける哉",
   "kana": "",
   "speaker": "",
   "page": 240,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "むは玉の夢にも人のみつのえのあくる恨はたれもはかなし",
   "kana": "",
   "speaker": "",
   "page": 240,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "あふとみし夢もなこりの泪さへしらぬ契にかゝるよひかな",
   "kana": "",
   "speaker": "",
   "page": 240,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "うたゝねにしばし休らふ心にもいとゝそつらき夢の名殘は",
   "kana": "",
   "speaker": "",
   "page": 240,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "なさけなく成行人の面影は夢にもつらきならひみかは",
   "kana": "",
   "speaker": "",
   "page": 240,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "夢にたにありし名殘を待わひぬねぬ夜の月の袖に馴つゝ",
   "kana": "",
   "speaker": "",
   "page": 240,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "81",
   "text": "うつゝこそ戀ちにいらめよをわたるとたえかちなる夢の浮橋",
   "kana": "",
   "speaker": "",
   "page": 240,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "82",
   "text": "わすれ草露ふかき夜の夢ちにやかよへる袖のひるよしもなき",
   "kana": "",
   "speaker": "",
   "page": 240,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "83",
   "text": "夢路にもあふよのかねはつらき哉なにを名殘の現ならねと",
   "kana": "",
   "speaker": "",
   "page": 240,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  }
 ],
 "catalog": {
